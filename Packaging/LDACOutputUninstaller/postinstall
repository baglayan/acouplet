#!/bin/sh
set -eu

if [ "${3:-}" != / ]; then
    printf '%s\n' 'Remove the audio driver from the current startup volume.' >&2
    exit 1
fi
ldac_team='@ACOUPLET_LDAC_SIGNING_TEAM_ID@'
case "$ldac_team" in
    [A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9][A-Z0-9]) ;;
    *)
        printf '%s\n' 'This removal package has no valid signing team. Nothing was removed.' >&2
        exit 1
        ;;
esac
require_stopped() {
    if /usr/bin/pgrep -f '/(Contents/MacOS/(Acouplet|XM5 Control|AcoupletAudio)|Contents/Helpers/(LDACSignaling|LDACMediaTransport|SonyAudioConnection|LDACLogObserver))( |$)' >/dev/null; then
        printf '%s\n' 'Stop LDAC and quit Acouplet before removing the audio driver. If it keeps reopening, remove its background service first. Nothing was removed.' >&2
        exit 1
    fi
}
require_stopped
for ldac_path in /Library/Audio/Plug-Ins/HAL/AcoupletLDACOutput.driver /Library/Audio/Plug-Ins/HAL/XM5LDACOutput.driver; do
    case "$ldac_path" in
        */AcoupletLDACOutput.driver) ldac_identifier=dev.baglayan.Acouplet.LDACOutput; ldac_executable=AcoupletVirtualOutput ;;
        */XM5LDACOutput.driver) ldac_identifier=local.xm5control.ldac-output-driver; ldac_executable=XM5VirtualOutput ;;
    esac
    if [ -e "$ldac_path" ] || [ -L "$ldac_path" ]; then
        if [ -L "$ldac_path" ] || [ ! -d "$ldac_path" ] || [ -L "$ldac_path/Contents" ] ||
           [ -L "$ldac_path/Contents/Info.plist" ] || [ -L "$ldac_path/Contents/MacOS" ] ||
           [ -L "$ldac_path/Contents/MacOS/$ldac_executable" ] ||
           [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$ldac_path/Contents/Info.plist" 2>/dev/null || true)" != "$ldac_identifier" ] ||
           [ "$(/usr/libexec/PlistBuddy -c 'Print :CFBundleExecutable' "$ldac_path/Contents/Info.plist" 2>/dev/null || true)" != "$ldac_executable" ]; then
            printf '%s\n' 'A driver path does not match the owned LDAC output identity. Nothing was removed.' >&2
            exit 1
        fi
        /usr/bin/codesign --verify --deep --strict --all-architectures \
            --test-requirement="=anchor apple generic and identifier \"$ldac_identifier\" and certificate leaf[subject.OU] = \"$ldac_team\"" "$ldac_path"
    fi
done
require_stopped
for ldac_path in /Library/Audio/Plug-Ins/HAL/XM5LDACOutput.driver /Library/Audio/Plug-Ins/HAL/AcoupletLDACOutput.driver; do
    if [ -d "$ldac_path" ]; then /bin/rm -rf "$ldac_path"; fi
done
for ldac_identifier in dev.baglayan.Acouplet.LDACOutput local.xm5control.ldac-output-driver; do
    if /usr/sbin/pkgutil --pkg-info "$ldac_identifier" >/dev/null 2>&1; then
        /usr/sbin/pkgutil --forget "$ldac_identifier" >/dev/null
    fi
done
printf '%s\n' 'The Acouplet LDAC audio driver was removed. Restart your Mac to finish unloading it.'
printf '%s\n' 'Core Audio was not restarted. Your app and preferences were kept.'
